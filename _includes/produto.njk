---
layout: base.njk
customScript: |
  // Carrossel de imagens melhorado
  const carousel = document.getElementById('carousel');
  if (carousel && carousel.children.length > 1) {
    const total = carousel.children.length;
    let index = 0;

    function updateCarousel(newIndex) {
      index = newIndex;
      carousel.style.transform = `translateX(-${index * 100}%)`;
      
      document.querySelectorAll('.carousel-indicator').forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove('bg-white/50');
          dot.classList.add('bg-white', 'scale-125');
        } else {
          dot.classList.remove('bg-white', 'scale-125');
          dot.classList.add('bg-white/50');
        }
      });
      
      document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
        if (i === index) {
          thumb.classList.add('ring-2', 'ring-blue-500');
        } else {
          thumb.classList.remove('ring-2', 'ring-blue-500');
        }
      });
    }

    document.getElementById('next').onclick = () => {
      updateCarousel((index + 1) % total);
    };

    document.getElementById('prev').onclick = () => {
      updateCarousel((index - 1 + total) % total);
    };
    
    document.querySelectorAll('.carousel-indicator').forEach((dot, i) => {
      dot.onclick = () => updateCarousel(i);
    });
    
    document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
      thumb.onclick = () => updateCarousel(i);
    });
    
    let autoplay = setInterval(() => {
      updateCarousel((index + 1) % total);
    }, 5000);
    
    carousel.parentElement.addEventListener('mouseenter', () => {
      clearInterval(autoplay);
    });
    
    carousel.parentElement.addEventListener('mouseleave', () => {
      autoplay = setInterval(() => {
        updateCarousel((index + 1) % total);
      }, 5000);
    });
  }

  // Sistema de Tabs
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.dataset.tab;

        tabButtons.forEach(btn => {
          btn.classList.remove('active', 'border-blue-500', 'text-gray-700');
          btn.classList.add('border-transparent', 'text-gray-500');
        });
        tabContents.forEach(content => {
          content.classList.add('hidden');
        });

        button.classList.add('active', 'border-blue-500', 'text-gray-700');
        button.classList.remove('border-transparent', 'text-gray-500');

        const targetContent = document.getElementById(`tab-${tabId}`);
        if (targetContent) {
          targetContent.classList.remove('hidden');
        }
      });
    });
  });
---

<main class="max-w-7xl mx-auto p-4 mt-6">
  
  <!-- Breadcrumb -->
  <nav class="text-sm mb-4 text-gray-600">
    <a href="/" class="hover:text-blue-500">Início</a>
    <span class="mx-2">/</span>
    <a href="/produtos/" class="hover:text-blue-500">Produtos</a>
    {% if categoria %}
    <span class="mx-2">/</span>
    <span class="capitalize">{{ categoria }}</span>
    {% endif %}
  </nav>

  <div class="flex flex-col lg:flex-row gap-8">
    
    <!-- Coluna Esquerda: Imagens + Resumo IA -->
    <div class="lg:w-1/2 space-y-4">
      
      <!-- Carrossel de Imagens -->
      {% if imagens and imagens.length > 0 %}
      <div class="space-y-3">
        <div class="relative w-full overflow-hidden rounded-lg shadow-md bg-white">
          <div id="carousel" class="flex transition-transform duration-500">
            {% for img in imagens %}
            <img src="{{ img.src }}" 
                 class="w-full flex-shrink-0 object-contain bg-white p-6" 
                 style="height: 450px;"
                 alt="{{ img.alt or produtoNome }}">
            {% endfor %}
          </div>
          
          {% if imagens.length > 1 %}
          <button id="prev" class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button id="next" class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
          
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
            {% for img in imagens %}
            <button class="carousel-indicator w-2.5 h-2.5 rounded-full bg-white/50 hover:bg-white/80 transition cursor-pointer"></button>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        
        {% if imagens.length > 1 %}
        <div class="flex gap-2 overflow-x-auto pb-2">
          {% for img in imagens %}
          <button class="thumbnail flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 border-gray-200 hover:border-blue-400 transition cursor-pointer bg-white">
            <img src="{{ img.src }}" 
                 class="w-full h-full object-contain p-1" 
                 alt="{{ img.alt or produtoNome }}">
          </button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      <!-- RESUMO DE OPINIÕES (IA) -->
      {% if resumoIA %}
      <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl p-6 border border-indigo-100">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-indigo-500 text-white p-3 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-800">Resumo de Opiniões</h2>
            <p class="text-xs text-gray-500">Gerado por Inteligência Artificial</p>
          </div>
        </div>
        <div class="bg-white rounded-lg p-4 text-gray-700 leading-relaxed">
          {{ resumoIA }}
        </div>
      </div>
      {% endif %}

    </div>

    <!-- Coluna Direita: Informações + Ofertas -->
    <div class="lg:w-1/2 flex flex-col gap-4">
      
      <h1 class="text-3xl font-bold text-gray-800">{{ produtoNome }}</h1>
      
      {% if marca %}
      <div class="text-sm text-gray-500">
        Marca: <span class="font-semibold text-gray-700">{{ marca }}</span>
      </div>
      {% endif %}

      <p class="text-gray-700 leading-relaxed">{{ produtoDescricao }}</p>

      <!-- OFERTAS -->
      {% if ofertas and ofertas.length > 0 %}
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100 shadow-sm mt-2">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="text-xl font-bold text-gray-800">Melhores Ofertas</h3>
        </div>
        
        <div class="space-y-3">
          {% set ofertasOrdenadas = ofertas | sort(attribute='preco') %}
          {% for oferta in ofertasOrdenadas %}
          {% set posicaoAtual = loop.index %}
          <div class="bg-white rounded-lg p-4 {% if posicaoAtual == 1 %}border-2 border-yellow-400 shadow-md{% else %}border border-gray-200{% endif %} hover:shadow-lg transition">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="{% if posicaoAtual == 1 %}text-2xl{% else %}text-xl{% endif %}">
                  {% if posicaoAtual == 1 %}🥇
                  {% elif posicaoAtual == 2 %}🥈
                  {% elif posicaoAtual == 3 %}🥉
                  {% elif posicaoAtual == 4 %}4️⃣
                  {% else %}🏪{% endif %}
                </span>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">{{ oferta.marketplace }}</div>
                  <div class="{% if posicaoAtual == 1 %}text-2xl font-bold text-green-600{% else %}text-xl font-bold text-gray-800{% endif %}">
                    R$ {{ oferta.preco | replace(".", ",") }}
                  </div>
                </div>
              </div>
              {% set btnColor = 'bg-green-500 hover:bg-green-600 text-white' %}
              {% if oferta.marketplace == 'Amazon' %}
                {% set btnColor = 'bg-blue-600 hover:bg-blue-700 text-white' %}
              {% elif oferta.marketplace == 'Mercado Livre' %}
                {% set btnColor = 'bg-yellow-400 hover:bg-yellow-500 text-gray-800' %}
              {% elif oferta.marketplace == 'Shopee' %}
                {% set btnColor = 'bg-orange-500 hover:bg-orange-600 text-white' %}
              {% endif %}
              <a href="{{ oferta.link }}" 
                 target="_blank" 
                 rel="noopener noreferrer nofollow"
                 class="{{ btnColor }} px-5 py-2.5 rounded-lg font-semibold transition shadow-sm hover:shadow-md flex items-center gap-2">
                Comprar
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
            {% if oferta.freteGratis %}
            <div class="mt-2 text-xs text-green-600 font-semibold flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Frete Grátis
            </div>
            {% else %}
            <div class="mt-2 text-xs text-gray-500 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Consulte o frete
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        
        <div class="mt-4 text-xs text-gray-500 text-center flex items-center justify-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Preços atualizados hoje
        </div>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- VÍDEO + TABS -->
  <div class="mt-12 flex flex-col lg:flex-row gap-8">
    
    {% if video %}
    <div class="lg:w-1/2">
      <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-6 border border-purple-100 h-full">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-purple-500 text-white p-3 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-800">Vídeo Explicativo</h2>
        </div>
        <div class="relative w-full rounded-lg overflow-hidden shadow-lg" style="padding-bottom: 56.25%;">
          <iframe class="absolute top-0 left-0 w-full h-full"
            src="{{ video }}"
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </div>
    {% endif %}

    <div class="{% if video %}lg:w-1/2{% else %}w-full{% endif %}">
      <div class="flex border-b border-gray-200 mb-6">
        <button class="tab-button active px-6 py-3 font-semibold text-gray-700 border-b-2 border-blue-500 hover:text-blue-600 transition" data-tab="caracteristicas">
          ✨ Características
        </button>
        <button class="tab-button px-6 py-3 font-semibold text-gray-500 border-b-2 border-transparent hover:text-blue-600 transition" data-tab="especificacoes">
          🔧 Especificações
        </button>
      </div>

      <div id="tab-caracteristicas" class="tab-content">
        {% if caracteristicas and caracteristicas.length > 0 %}
        <div class="space-y-3">
          {% for item in caracteristicas %}
          <div class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-md transition">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-700 leading-relaxed">{{ item }}</span>
            </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="text-gray-500 text-center py-8">Nenhuma característica disponível.</p>
        {% endif %}
      </div>

      <div id="tab-especificacoes" class="tab-content hidden">
        {% if especificacoes %}
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <div class="space-y-0">
            {% for key, value in especificacoes %}
            <div class="{% if loop.index % 2 == 0 %}bg-gray-50{% else %}bg-white{% endif %} p-4 border-b border-gray-200 last:border-b-0">
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-600 mb-1">{{ key }}</span>
                <span class="text-gray-800">{{ value }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <p class="text-gray-500 text-center py-8">Nenhuma especificação disponível.</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- MAIS INFORMAÇÕES (SEO) -->
  {% if conteudoExtra %}
  <div class="mt-12 bg-gray-50 rounded-xl p-8 border border-gray-200">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-blue-500 text-white p-3 rounded-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-800">Mais Informações</h2>
    </div>
    <div class="prose max-w-none text-gray-700 leading-relaxed">
      {{ conteudoExtra | safe }}
    </div>
  </div>
  {% endif %}

</main>