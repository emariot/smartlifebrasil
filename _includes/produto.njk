---
layout: base.njk
---

<!-- ✅ 1. PRELOAD da primeira imagem (LCP otimizado) -->
{% if imagens and imagens.length > 0 %}
<link rel="preload" as="image" href="{{ imagens[0].src }}">
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ produtoNome }}",
  "description": "{{ produtoDescricao | replace('\n', ' ') | safe }}",
  
  {% if gtin %}"gtin": "{{ gtin }}",{% endif %} 

  {% if imagens and imagens.length > 0 %}
  "image": "https://smartlifebr.com.br{{ imagens[0].src }}",
  {% endif %}

  {% if marca %}
  "brand": {
    "@type": "Brand",
    "name": "{{ marca }}"
  },
  {% endif %}

  {% if ofertas and ofertas.length > 0 %}
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "BRL",
    "lowPrice": "{{ ofertas | sort(attribute='preco') | first | attr('preco') }}",
    "offerCount": {{ ofertas | length }},
    "offers": [
      {% for oferta in ofertas %}
      {
        "@type": "Offer",
        "url": "{{ oferta.link }}",
        "priceCurrency": "BRL",
        "price": "{{ oferta.preco }}",
        "priceValidUntil": "2030-12-31",
        "seller": {
          "@type": "Organization",
          "name": "{{ oferta.marketplace }}"
        },
        "availability": "https://schema.org/InStock"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  {% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "https://smartlifebr.com.br/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Produtos",
      "item": "https://smartlifebr.com.br/produtos/"
    }
    {% if categoria %}
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{ categoria | capitalize }}",
      "item": "https://smartlifebr.com.br/produtos/{{ categoria }}/"
    }
    {% endif %}
    {% if subcategoria %}
    ,{
      "@type": "ListItem",
      "position": 4,
      "name": "{{ subcategoria | replace('-', ' ') | capitalize }}",
      "item": "https://smartlifebr.com.br/produtos/{{ categoria }}/{{ subcategoria }}/"
    }
    {% endif %}
  ]
}
</script>

<main class="max-w-7xl mx-auto p-4 mt-6">
  
  <!-- Breadcrumb -->
<nav class="text-sm mb-4 text-gray-600">
  <a href="/" class="hover:text-blue-500">Início</a>
  <span class="mx-2">/</span>
  <span>Produtos</span>
  {% if categoria %}
  <span class="mx-2">/</span>
  <span class="capitalize">{{ categoria }}</span>
  {% endif %}
  {% if subcategoria %}
  <span class="mx-2">/</span>
  {% set subcategoriaNome = subcategoria | replace("-", " ") | capitalize %}
  {% for page in collections.all %}
    {% if page.data.subcategoria == subcategoria and page.data.titulo %}
      {% set subcategoriaNome = page.data.titulo %}
    {% endif %}
  {% endfor %}
  <a href="/produtos/{{ categoria }}/{{ subcategoria }}" class="hover:text-blue-500">
    {{ subcategoriaNome }}
  </a>
  {% endif %}
</nav>

  <div class="flex flex-col lg:flex-row gap-8">
    
    <!-- Coluna Esquerda: Imagens + Resumo IA -->
    <div class="lg:w-1/2 space-y-4">
      
      <!-- ✅ Carrossel de Imagens MELHORADO -->
      {% if imagens and imagens.length > 0 %}
      <div class="space-y-3">
        <!-- 3. ARIA labels melhorados -->
        <div class="carousel-container relative w-full overflow-hidden rounded-lg shadow-md bg-white {% if imagens.length > 1 %}has-multiple{% endif %}"
             role="region" 
             aria-label="Galeria de imagens do produto"
             aria-live="polite">
          
          <!-- 6. Loading skeleton -->
          <div class="carousel-skeleton absolute inset-0 z-10" 
               style="height: 450px;"
               aria-hidden="true"></div>
          
          <div id="carousel" class="flex transition-transform duration-500">
            {% for img in imagens %}
            <img data-src="{{ img.src }}"
                 {% if loop.first %}src="{{ img.src }}"{% endif %}
                 class="carousel-image w-full flex-shrink-0 object-contain bg-white p-6 {% if loop.first %}loaded{% endif %}" 
                 style="height: 450px;"
                 alt="{{ img.alt or produtoNome }}"
                 {% if not loop.first %}loading="lazy"{% endif %}
                 aria-label="Imagem {{ loop.index }} de {{ imagens.length }}">
            {% endfor %}
          </div>
          
          {% if imagens.length > 1 %}
          <button id="prev" 
                  class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110"
                  aria-label="Ver imagem anterior">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button id="next" 
                  class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110"
                  aria-label="Ver próxima imagem">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
          
          <!-- Indicador textual para screen readers -->
          <div class="sr-only" aria-live="polite" id="carousel-status">
            Imagem 1 de {{ imagens.length }}
          </div>
          
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
            {% for img in imagens %}
            <button class="carousel-indicator w-2.5 h-2.5 rounded-full bg-white/50 hover:bg-white/80 cursor-pointer"
                    aria-label="Ir para imagem {{ loop.index }}"></button>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        
        {% if imagens.length > 1 %}
        <div class="flex gap-2 overflow-x-auto pb-2">
          {% for img in imagens %}
          <button class="thumbnail flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 border-gray-200 hover:border-blue-400 transition cursor-pointer bg-white"
                  aria-label="Ver imagem {{ loop.index }}">
            <img src="{{ img.src }}" 
                 class="w-full h-full object-contain p-1" 
                 alt="{{ img.alt or produtoNome }}"
                 loading="lazy">
          </button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      <!-- RESUMO DE OPINIÕES (IA) -->
      {% if resumoIA %}
      <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl p-6 border border-indigo-100">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-indigo-500 text-white p-3 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-800">Resumo de Opiniões</h2>
            <p class="text-xs text-gray-500">Gerado por Inteligência Artificial</p>
          </div>
        </div>
        <div class="bg-white rounded-lg p-4 text-gray-700 leading-relaxed">
          {{ resumoIA }}
        </div>
      </div>
      {% endif %}

    </div>

    <!-- Coluna Direita: Informações + Ofertas -->
    <div class="lg:w-1/2 flex flex-col gap-4">
      
      <h1 class="text-3xl font-bold text-gray-800">{{ produtoNome }}</h1>
      
      {% if marca %}
      <div class="text-sm text-gray-500">
        Marca: <span class="font-semibold text-gray-700">{{ marca }}</span>
      </div>
      {% endif %}

      <p class="text-gray-700 leading-relaxed">{{ produtoDescricao }}</p>

      <!-- OFERTAS -->
      {% if ofertas and ofertas.length > 0 %}
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-5 border border-blue-100 shadow-sm mt-2">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="text-xl font-bold text-gray-800">Melhores Ofertas</h3>
        </div>
        
        <div class="space-y-3">
          {% set ofertasOrdenadas = ofertas | sort(attribute='preco') %}
          {% for oferta in ofertasOrdenadas %}
          {% set posicaoAtual = loop.index %}
          <div class="bg-white rounded-lg p-4 {% if posicaoAtual == 1 %}border-2 border-yellow-400 shadow-md{% else %}border border-gray-200{% endif %} hover:shadow-lg transition">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="{% if posicaoAtual == 1 %}text-2xl{% else %}text-xl{% endif %}">
                  {% if posicaoAtual == 1 %}🥇
                  {% elif posicaoAtual == 2 %}🥈
                  {% elif posicaoAtual == 3 %}🥉
                  {% elif posicaoAtual == 4 %}4️⃣
                  {% else %}🏪{% endif %}
                </span>
                <div>
                  <div class="text-xs text-gray-500 uppercase font-semibold">{{ oferta.marketplace }}</div>
                  <div class="{% if posicaoAtual == 1 %}text-2xl font-bold text-green-600{% else %}text-xl font-bold text-gray-800{% endif %}">
                    R$ {{ oferta.preco | replace(".", ",") }}
                  </div>
                </div>
              </div>
              {% set btnColor = 'bg-green-500 hover:bg-green-600 text-white' %}
              {% if oferta.marketplace == 'Amazon' %}
                {% set btnColor = 'bg-blue-600 hover:bg-blue-700 text-white' %}
              {% elif oferta.marketplace == 'Mercado Livre' %}
                {% set btnColor = 'bg-yellow-400 hover:bg-yellow-500 text-gray-800' %}
              {% elif oferta.marketplace == 'Shopee' %}
                {% set btnColor = 'bg-orange-500 hover:bg-orange-600 text-white' %}
              {% endif %}
              <a href="{{ oferta.link }}" 
                 target="_blank" 
                 rel="noopener noreferrer nofollow"
                 onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_oferta_produto', {'marketplace': '{{ oferta.marketplace }}', 'produto': '{{ produtoNome }}', 'preco': '{{ oferta.preco }}', 'posicao': '{{ posicaoAtual }}'}); }"
                 class="{{ btnColor }} px-5 py-2.5 rounded-lg font-semibold transition shadow-sm hover:shadow-md flex items-center gap-2">
                Comprar
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
            {% if oferta.freteGratis %}
            <div class="mt-2 text-xs text-green-600 font-semibold flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Frete Grátis
            </div>
            {% else %}
            <div class="mt-2 text-xs text-gray-500 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Consulte o frete
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        
        <div class="mt-4 text-xs text-gray-500 text-center flex items-center justify-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Preço atualizado hoje, <span class="whitespace-nowrap">sujeitos a variação conforme o marketplace.</span>
        </div>
      </div>
      {% endif %}
    </div>
  </div>


  <!-- VÍDEOS + TABS -->
  <div class="mt-12 flex flex-col lg:flex-row gap-8">
    
    {% if videos and videos.length > 0 %}
    <div class="lg:w-1/2">
      <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-6 border border-purple-100 h-full">
        <div class="flex items-center gap-3 mb-4">
          <div class="bg-purple-500 text-white p-3 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-gray-800">Vídeos Explicativos</h2>
            <p class="text-xs text-gray-500">{{ videos.length }} vídeo{% if videos.length > 1 %}s{% endif %} disponível{% if videos.length > 1 %}is{% endif %}</p>
          </div>
        </div>
        
        <!-- Carrossel de Vídeos -->
        <div class="videos-carousel-container relative">
          <div id="videos-carousel" class="flex gap-4 overflow-x-auto scroll-smooth pb-2" style="scrollbar-width: thin;">
            {% for videoItem in videos %}
            <div class="video-item flex-shrink-0 w-full">
              <div class="relative w-full rounded-lg overflow-hidden shadow-lg mb-2" style="padding-bottom: 56.25%;">
                <iframe class="absolute top-0 left-0 w-full h-full"
                  src="{{ videoItem.url }}?controls=1&modestbranding=1&rel=0&showinfo=0"
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                  loading="lazy">
                </iframe>
              </div>
              {% if videoItem.titulo %}
              <div class="text-sm font-semibold text-gray-700 mb-1">{{ videoItem.titulo }}</div>
              {% endif %}
              {% if videoItem.canal %}
              <div class="text-xs text-gray-500">Canal: {{ videoItem.canal }}</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          
          {% if videos.length > 1 %}
          <!-- Navegação -->
          <button id="videos-prev" 
                  class="absolute left-0 top-1/3 -translate-y-1/2 bg-white/90 hover:bg-white p-2 rounded-full shadow-lg transition hover:scale-110 z-10"
                  aria-label="Vídeo anterior">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button id="videos-next" 
                  class="absolute right-0 top-1/3 -translate-y-1/2 bg-white/90 hover:bg-white p-2 rounded-full shadow-lg transition hover:scale-110 z-10"
                  aria-label="Próximo vídeo">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
          
          <!-- Indicadores -->
          <div class="flex justify-center gap-2 mt-3">
            {% for videoItem in videos %}
            <button class="video-indicator w-2 h-2 rounded-full bg-gray-300 hover:bg-gray-400 transition"
                    data-index="{{ loop.index0 }}"
                    aria-label="Ir para vídeo {{ loop.index }}"></button>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}

    <div class="{% if video or videos %}lg:w-1/2{% else %}w-full{% endif %}">
      <div class="flex border-b border-gray-200 mb-6">
        <button class="tab-button active px-6 py-3 font-semibold text-gray-700 border-b-2 border-blue-500 hover:text-blue-600 transition" data-tab="caracteristicas">
          ✨ Características
        </button>
        <button class="tab-button px-6 py-3 font-semibold text-gray-500 border-b-2 border-transparent hover:text-blue-600 transition" data-tab="especificacoes">
          🔧 Especificações
        </button>
      </div>

      <div id="tab-caracteristicas" class="tab-content">
        {% if caracteristicas and caracteristicas.length > 0 %}
        <div class="space-y-3">
          {% for item in caracteristicas %}
          <div class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-md transition">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-green-100 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-700 leading-relaxed">{{ item }}</span>
            </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="text-gray-500 text-center py-8">Nenhuma característica disponível.</p>
        {% endif %}
      </div>

      <div id="tab-especificacoes" class="tab-content hidden">
        {% if especificacoes %}
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
          <div class="space-y-0">
            {% for key, value in especificacoes %}
            <div class="{% if loop.index % 2 == 0 %}bg-gray-50{% else %}bg-white{% endif %} p-4 border-b border-gray-200 last:border-b-0">
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-600 mb-1">{{ key }}</span>
                <span class="text-gray-800">{{ value }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <p class="text-gray-500 text-center py-8">Nenhuma especificação disponível.</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- MAIS INFORMAÇÕES (SEO) -->
  {% if conteudoExtra %}
  <div class="mt-12 bg-gray-50 rounded-xl p-8 border border-gray-200">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-blue-500 text-white p-3 rounded-lg">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-800">Mais Informações</h2>
    </div>
    <div class="prose max-w-none text-gray-700 leading-relaxed">
      {{ conteudoExtra | safe }}
    </div>
  </div>
  {% endif %}

</main>

<script src="/atualiza-precos-produtos.js"></script>