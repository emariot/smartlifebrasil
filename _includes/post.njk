---
layout: base.njk
customCSS: |
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Merriweather:wght@400;700&display=swap');
  body { font-family: 'Poppins', sans-serif; }
  
  .post-content {
    font-family: 'Merriweather', serif;
    font-size: 1.125rem;
    line-height: 1.8;
    color: #374151;
  }
  
  .post-content h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    color: #1f2937;
  }
  
  .post-content h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #374151;
  }
  
  .post-content p {
    margin-bottom: 1.5rem;
  }
  
  .post-content ul, .post-content ol {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }
  
  .post-content ul {
    list-style-type: disc;
  }
  
  .post-content ol {
    list-style-type: decimal;
  }
  
  .post-content li {
    margin-bottom: 0.5rem;
    display: list-item;
  }
  
  .post-content ul ul {
    list-style-type: circle;
    margin-top: 0.5rem;
  }
  
  .post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  
  .post-content table thead {
    background: #f3f4f6;
  }
  
  .post-content table th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: #1f2937;
    border-bottom: 2px solid #e5e7eb;
  }
  
  .post-content table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e5e7eb;
    color: #374151;
  }
  
  .post-content table tbody tr:hover {
    background: #f9fafb;
  }
  
  .post-content table tbody tr:last-child td {
    border-bottom: none;
  }
  
  .post-content a {
    color: #3b82f6;
    text-decoration: underline;
    transition: color 0.2s;
  }
  
  .post-content a:hover {
    color: #1d4ed8;
  }
  
  .post-content blockquote {
    border-left: 4px solid #3b82f6;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #6b7280;
  }
  
  .post-content img {
    border-radius: 0.75rem;
    margin: 2rem auto;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .post-content img.align-left {
    display: block;
    margin: 2rem 0 2rem 0; /* remove centralização */
  }
  
  .post-content code {
    background: #f3f4f6;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .post-content img[alt*="Tela do app"] {
    max-width: 400px;
    margin: 1.5rem auto;
    display: block;
  }
  
  .post-content pre {
    background: #1f2937;
    color: #f3f4f6;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 2rem 0;
  }
    
  .post-content pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  
  .share-button {
    transition: all 0.3s ease;
  }
  
  .share-button:hover {
    transform: translateY(-2px);
  }
  

---
{% if title and description and date %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description | replace('\n', ' ') | safe }}",
  {% if imagem %}
  "image": "https://smartlifebr.com.br{{ imagem }}",
  {% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ autor or 'Equipe Smart Life Brasil' }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Smart Life Brasil",
    "logo": {
      "@type": "ImageObject",
      "url": "https://smartlifebr.com.br/assets/img/mascote.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://smartlifebr.com.br{{ page.url }}"
  },
  "datePublished": "{{ date | dateToISO }}",
  "dateModified": "{{ date | dateToISO }}"
}
</script>
{% endif %}

<!-- Progress Bar de Leitura -->
<div class="fixed top-0 left-0 right-0 h-1 bg-gray-200 z-50">
  <div id="progress-bar" class="h-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-150"></div>
</div>

<!-- Hero do Post -->
<article class="bg-gradient-to-b from-gray-50 to-white">
  
  <!-- Header do Post -->
  <header class="max-w-4xl mx-auto px-4 pt-12 pb-8">
    
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6 text-gray-600">
      <a href="/" class="hover:text-blue-500">Início</a>
      <span class="mx-2">/</span>
      <a href="/blog/" class="hover:text-blue-500">Blog</a>
      {% if categoriaBlog %}
      <span class="mx-2">/</span>
      <span class="capitalize">{{ categoriaBlog }}</span>
      {% endif %}
    </nav>
    
    <!-- Categoria Badge -->
    <div class="mb-4">
      {% set categoryColor = 'bg-blue-500' %}
      {% set categoryEmoji = '📑' %}
      {% if categoriaBlog == 'guias' %}
        {% set categoryColor = 'bg-green-500' %}
        {% set categoryEmoji = '📚' %}
      {% elif categoriaBlog == 'noticias' %}
        {% set categoryColor = 'bg-red-500' %}
        {% set categoryEmoji = '📰' %}
      {% elif categoriaBlog == 'dicas' %}
        {% set categoryColor = 'bg-yellow-500' %}
        {% set categoryEmoji = '💡' %}
      {% elif categoriaBlog == 'reviews' %}
        {% set categoryColor = 'bg-purple-500' %}
        {% set categoryEmoji = '⭐' %}
      {% endif %}
      
      <span class="{{ categoryColor }} text-white px-4 py-2 rounded-full text-sm font-bold uppercase inline-flex items-center gap-2">
        {{ categoryEmoji }} {{ categoriaBlog or 'Geral' }}
      </span>
    </div>
    
    <!-- Título -->
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
      {{ title }}
    </h1>
    
    <!-- Meta Info -->
    <div class="flex flex-wrap items-center gap-6 text-gray-600 mb-8">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span>{{ date | formatDate }}</span>
      </div>
      
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>{{ content | readingTime }} de leitura</span>
      </div>
      
      {% if autor %}
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span>Por {{ autor }}</span>
      </div>
      {% endif %}
    </div>
    
    <!-- Descrição -->
    {% if description %}
    <p class="text-xl text-gray-600 leading-relaxed border-l-4 border-blue-500 pl-6 py-2">
      {{ description }}
    </p>
    {% endif %}
  </header>
  
  <!-- Imagem Destaque -->
  {% if imagem %}
  <div class="max-w-2xl mx-auto px-4 mb-12">
    <img src="{{ imagem }}" 
         alt="{{ title }}"
         class="w-full rounded-2xl shadow-2xl">
  </div>
  {% endif %}
  
  <!-- Conteúdo do Post -->
  <div class="max-w-3xl mx-auto px-4 pb-16">
    <div class="post-content bg-white rounded-2xl shadow-lg p-8 md:p-12">
      {{ content | safe }}
    </div>
    
    <!-- Tags -->
    {% if tags %}
    <div class="mt-8 flex flex-wrap gap-2">
      <span class="text-gray-600 font-semibold mr-2">Tags:</span>
      {% for tag in tags %}
        {% if tag != 'post' %}
        <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm hover:bg-gray-200 transition">
          #{{ tag }}
        </span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
    
    <!-- Compartilhar -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-xl font-bold text-gray-800 mb-4">📤 Compartilhe este artigo</h3>
      <div class="flex flex-wrap gap-3">
        <button onclick="shareOnTwitter()" 
                class="share-button bg-blue-400 hover:bg-blue-500 text-white px-6 py-3 rounded-lg font-semibold shadow-md flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>
          </svg>
          Twitter
        </button>
        
        <button onclick="shareOnFacebook()" 
                class="share-button bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold shadow-md flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </button>
        
        <button onclick="shareOnWhatsApp()" 
                class="share-button bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-semibold shadow-md flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </button>
        
        <button onclick="copyLink()" 
                class="share-button bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg font-semibold shadow-md flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          Copiar Link
        </button>
      </div>
    </div>
    
    <!-- Posts Relacionados -->
    {% set relatedPosts = collections.blog | reverse | slice(0, 3) %}
    {% if relatedPosts.length > 0 %}
    <div class="mt-16 pt-12 border-t-2 border-gray-200">
      <h3 class="text-2xl font-bold text-gray-800 mb-8">📚 Continue lendo</h3>
      <div class="grid md:grid-cols-3 gap-6">
        {% for post in relatedPosts %}
          {% if post.url != page.url %}
          <a href="{{ post.url }}" class="group bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition">
            <div class="h-40 bg-gradient-to-br from-blue-100 to-purple-100 overflow-hidden">
              <img src="{{ post.data.imagem or '/assets/img/blog-default.jpg' }}" 
                   alt="{{ post.data.title }}"
                   class="w-full h-full object-cover group-hover:scale-110 transition duration-300">
            </div>
            <div class="p-4">
              <h4 class="font-bold text-gray-800 mb-2 line-clamp-2 group-hover:text-blue-600 transition">
                {{ post.data.title }}
              </h4>
              <p class="text-sm text-gray-600 line-clamp-2">
                {{ post.data.description or (post.templateContent | excerpt(100)) }}
              </p>
            </div>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
    
    <!-- CTA Final -->
    <div class="mt-16 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl p-8 text-center text-white shadow-xl">
      <h3 class="text-2xl font-bold mb-3">🎉 Gostou deste artigo?</h3>
      <p class="text-lg mb-6 text-blue-50">Explore nossos produtos inteligentes e transforme sua vida!</p>
      <a href="/" 
         class="bg-white text-blue-600 px-8 py-3 rounded-lg hover:bg-blue-50 transition font-bold inline-flex items-center gap-2 shadow-lg">
        Ver Produtos
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
  
</article>