---
layout: base.njk
---

<!-- Breadcrumb -->
<nav class="bg-gray-50 border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <ol class="flex items-center space-x-2 text-sm">
      <li><a href="/" class="text-blue-600 hover:text-blue-800">Home</a></li>
      <li class="text-gray-400">/</li>
      <li><a href="/produtos" class="text-blue-600 hover:text-blue-800">Produtos</a></li>
      <li class="text-gray-400">/</li>
      <li><a href="/produtos/{{ categoria }}" class="text-blue-600 hover:text-blue-800 capitalize">{{ categoria }}</a></li>
      <li class="text-gray-400">/</li>
      <li class="text-gray-700 font-semibold">{{ titulo }}</li>
    </ol>
  </div>
</nav>

<!-- Header da Categoria -->
<section class="bg-gradient-to-r from-blue-500 to-blue-600 text-white py-12">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-4xl font-bold mb-3">{{ titulo }}</h1>
    <p class="text-xl text-blue-100">{{ descricao }}</p>
  </div>
</section>

<!-- Main -->
<main class="max-w-7xl mx-auto p-4">
  
  <!-- Barra de pesquisa e filtros -->
  <section class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Filtros por marca (opcional - será preenchido via JS) -->
    <div class="flex flex-wrap gap-2" id="filtros-marca">
      <button class="filter-marca bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400" data-marca="all">
        Todas as Marcas
      </button>
    </div>
    
    <!-- Barra de pesquisa -->
    <div class="flex">
      <input type="text" id="search-input" placeholder="Pesquisar nesta categoria..." class="border border-gray-300 rounded-l px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <button id="search-btn" class="bg-blue-500 text-white px-4 py-2 rounded-r hover:bg-blue-600">🔍</button>
    </div>
  </section>
  
  <!-- Grid de produtos -->
  <section id="produtos">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold">Produtos em {{ titulo }}</h2>
      <p class="text-gray-600" id="contador-produtos">0 produto(s) encontrado(s)</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 grid-produtos">
      
      {% set produtosFiltrados = [] %}
      {% for produto in collections.produto %}
        {% if produto.data.categoria == categoria and produto.data.subcategoria == subcategoria %}
          {% set produtosFiltrados = (produtosFiltrados.push(produto), produtosFiltrados) %}
        {% endif %}
      {% endfor %}
      
      {% for produto in produtosFiltrados %}
      {% set ofertas = produto.data.ofertas | sort(attribute='preco') %}
      {% set melhorOferta = ofertas[0] if ofertas else null %}
      
      <div class="product-card bg-white rounded-lg shadow-md flex flex-col overflow-hidden" 
           data-categoria="{{ produto.data.categoria or 'geral' }}"
           data-marca="{{ produto.data.marca | lower }}">
        
        <!-- Imagem Container -->
        <div class="relative w-full h-48 bg-white flex items-center justify-center p-4">
          <img src="{{ produto.data.imagemCard or produto.data.imagens[0].src or '/assets/img/placeholder.jpg' }}" 
               alt="{{ produto.data.produtoNome }}" 
               class="max-h-full max-w-full object-contain">
          
          {% if produto.data.novo %}
          <span class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 text-xs font-bold rounded">NOVO</span>
          {% endif %}
        </div>
        
        <!-- Conteúdo -->
        <div class="p-4 flex flex-col flex-grow">
          {% if produto.data.marca %}
          <div class="text-xs text-gray-500 uppercase font-semibold mb-1">{{ produto.data.marca }}</div>
          {% endif %}
          
          <h3 class="text-lg font-bold mb-2 line-clamp-2">{{ produto.data.produtoNome }}</h3>
          
          <p class="text-gray-600 text-sm mb-3 flex-grow line-clamp-2">
            {{ produto.data.description or produto.data.produtoDescricao or "Descrição não disponível" }}
          </p>
          
          <!-- Preço + Botão Ver Ofertas -->
          {% if melhorOferta %}
          <div class="mb-3">
            <div class="bg-green-50 rounded-lg px-3 py-2 mb-2">
              <p class="text-xs text-gray-600">A partir de</p>
              <p class="text-xl font-bold text-green-600">R$ {{ melhorOferta.preco | replace(".", ",") }}</p>
            </div>
            <button class="toggle-ofertas w-full bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold flex items-center justify-center gap-2"
                    onclick="if(typeof gtag !== 'undefined') { gtag('event', 'abrir_ofertas_categoria', {'produto': '{{ produto.data.produtoNome }}', 'categoria': '{{ titulo }}'}); }">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Ver Ofertas
            </button>
          </div>
          {% endif %}
          
          <!-- Botão Ver Detalhes -->
          <a href="{{ produto.url }}" 
            onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_ver_detalhes_categoria', {'produto': '{{ produto.data.produtoNome }}', 'categoria': '{{ titulo }}'}); }"
            class="bg-gray-800 text-white px-4 py-2.5 rounded-lg text-center hover:bg-gray-900 transition font-semibold flex items-center justify-center gap-2">
            Ver Detalhes
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <!-- OVERLAY DE OFERTAS -->
        {% if ofertas and ofertas.length > 0 %}
        <div class="ofertas-overlay">
          <div class="ofertas-overlay-content">
            <!-- Botão Fechar -->
            <button class="close-ofertas absolute top-3 right-3 bg-white/20 hover:bg-white/30 text-white p-2 rounded-full transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            
            <!-- Título -->
            <div class="text-center mb-6">
              <h3 class="text-white text-xl font-bold mb-1">💰 Melhores Ofertas</h3>
              <p class="text-gray-300 text-sm">Clique para comprar</p>
            </div>
            
            <!-- Lista de Ofertas -->
            <div class="space-y-2">
              {% for oferta in ofertas %}
              {% set posicao = loop.index %}
              {% set emoji = '🥇' if posicao == 1 else ('🥈' if posicao == 2 else ('🥉' if posicao == 3 else ('4️⃣' if posicao == 4 else '🪙'))) %}
              {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
              {% if oferta.marketplace == 'Mercado Livre' %}
                {% set bgColor = 'bg-yellow-400 hover:bg-yellow-500 text-gray-800' %}
              {% elif oferta.marketplace == 'Shopee' %}
                {% set bgColor = 'bg-orange-500 hover:bg-orange-600' %}
              {% elif oferta.marketplace == 'Amazon' %}
                {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
              {% else %}
                {% set bgColor = 'bg-green-500 hover:bg-green-600' %}
              {% endif %}
              
              <a href="{{ oferta.link }}" 
                target="_blank" 
                rel="noopener noreferrer nofollow"
                onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_oferta_overlay_categoria', {'marketplace': '{{ oferta.marketplace }}', 'produto': '{{ produto.data.produtoNome }}', 'preco': '{{ oferta.preco }}', 'posicao': '{{ posicao }}', 'categoria': '{{ titulo }}'}); }"
                class="{{ bgColor }} text-white text-xs px-3 py-3 rounded-lg font-semibold transition shadow-md hover:shadow-lg flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                  <span class="text-lg">{{ emoji }}</span>
                  <span class="flex flex-col items-start leading-tight">
                    <span>{{ oferta.marketplace }}</span>
                    {% if oferta.freteGratis %}
                      <span class="text-xs text-white font-normal">Frete grátis</span>
                    {% else %}
                      <span class="text-xs text-white font-normal">Consulte o frete</span>
                    {% endif %}
                  </span>
                </span>
                <span class="text-lg font-bold">R$ {{ oferta.preco | replace(".", ",") }}</span>
              </a>
              {% endfor %}
            </div>
          </div>
        </div>
        {% endif %}
        
      </div>
      {% endfor %}
      
      {% if produtosFiltrados.length == 0 %}
      <div class="col-span-full text-center py-12 bg-white rounded-lg shadow-md">
        <p class="text-gray-500 text-lg mb-2">😕 Nenhum produto encontrado nesta categoria.</p>
        <a href="/produtos" class="text-blue-600 hover:text-blue-800 font-semibold">← Voltar para todos os produtos</a>
      </div>
      {% endif %}

    </div>
  </section>
</main>

<script>
// Atualizar contador de produtos
document.addEventListener('DOMContentLoaded', function() {
  const cards = document.querySelectorAll('.product-card');
  const contador = document.getElementById('contador-produtos');
  
  function atualizarContador() {
    const visibleCards = Array.from(cards).filter(card => card.style.display !== 'none');
    contador.textContent = `${visibleCards.length} produto(s) encontrado(s)`;
  }
  
  atualizarContador();
  
  // Coletar marcas únicas e criar filtros
  const marcas = new Set();
  cards.forEach(card => {
    const marca = card.dataset.marca;
    if (marca) marcas.add(marca);
  });
  
  // Criar botões de filtro por marca (se houver mais de uma marca)
  if (marcas.size > 1) {
    const filtrosMarca = document.getElementById('filtros-marca');
    marcas.forEach(marca => {
      const btn = document.createElement('button');
      btn.className = 'filter-marca bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600';
      btn.dataset.marca = marca;
      btn.textContent = marca.charAt(0).toUpperCase() + marca.slice(1);
      filtrosMarca.appendChild(btn);
    });
  }
  
  // Filtro por marca
  document.querySelectorAll('.filter-marca').forEach(btn => {
    btn.addEventListener('click', function() {
      const marca = this.dataset.marca;
      
      // Atualizar botões ativos
      document.querySelectorAll('.filter-marca').forEach(b => {
        b.classList.remove('bg-blue-600', 'bg-gray-400');
        b.classList.add(b === this ? 'bg-blue-600' : 'bg-blue-500');
      });
      
      // Filtrar produtos
      cards.forEach(card => {
        if (marca === 'all' || card.dataset.marca === marca) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
      
      atualizarContador();
    });
  });
  
  // Busca
  const searchInput = document.getElementById('search-input');
  const searchBtn = document.getElementById('search-btn');
  
  function buscar() {
    const termo = searchInput.value.toLowerCase();
    cards.forEach(card => {
      const texto = card.textContent.toLowerCase();
      card.style.display = texto.includes(termo) ? 'block' : 'none';
    });
    atualizarContador();
  }
  
  searchBtn.addEventListener('click', buscar);
  searchInput.addEventListener('keyup', function(e) {
    if (e.key === 'Enter') buscar();
  });
});
</script>