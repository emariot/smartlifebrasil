---
layout: base.njk
title: Blog - Smart Life Brasil
description: Dicas, guias e novidades sobre produtos inteligentes para sua casa, negócio e vida
permalink: /blog/
customCSS: |
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');
  body { font-family: 'Poppins', sans-serif; }
  
  .blog-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }
  
  .category-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .featured-post {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

    

customScript: |
  // Filtros de categoria
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filter;

      // Tracking
      if(typeof gtag !== 'undefined') { 
        gtag('event', 'filtro_blog', {'categoria': filtro}); 
      }

      const posts = document.querySelectorAll('.blog-post-card');
      
      posts.forEach(post => {
        if (filtro === 'all' || post.dataset.categoria === filtro) {
          post.classList.remove('hidden');
        } else {
          post.classList.add('hidden');
        }
      });
      
      // Destaca o botão ativo
      filterBtns.forEach(b => {
        b.classList.remove('ring-2', 'ring-blue-400', 'bg-blue-600');
        b.classList.add('bg-blue-500');
      });
      btn.classList.add('ring-2', 'ring-blue-400', 'bg-blue-600');
      btn.classList.remove('bg-blue-500');
    });
  });

  // Pesquisa
  const searchInput = document.getElementById('blog-search');
  const searchBtn = document.getElementById('blog-search-btn');

  function pesquisarBlog() {
    const termo = searchInput.value.toLowerCase();

    // Tracking
    if(typeof gtag !== 'undefined' && termo.length > 0) { 
      gtag('event', 'pesquisa_blog', {'termo': termo}); 
    }

    const posts = document.querySelectorAll('.blog-post-card');
    
    posts.forEach(post => {
      const titulo = post.querySelector('h3').textContent.toLowerCase();
      const descricao = post.querySelector('.post-excerpt')?.textContent.toLowerCase() || '';
      
      if (titulo.includes(termo) || descricao.includes(termo)) {
        post.classList.remove('hidden');
      } else {
        post.classList.add('hidden');
      }
    });
  }

  searchBtn.addEventListener('click', pesquisarBlog);
  searchInput.addEventListener('keyup', e => {
    if (e.key === 'Enter') pesquisarBlog();
  });
---

{# Filtra artigos publicados manualmente (excluindo rascunhos) #}
{% set publishedPosts = [] %}
{% for post in collections.blog %}
  {% if not post.data.draft %}
    {% set publishedPosts = (publishedPosts.push(post), publishedPosts) %}
  {% endif %}
{% endfor %}

<!-- Hero Section -->
<section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Blog Smart Life Brasil</h1>
    <p class="text-xl md:text-2xl text-blue-100 mb-6">Dicas, guias e novidades sobre produtos inteligentes</p>
    <div class="flex flex-wrap justify-center gap-2">
      <span class="bg-white/20 px-4 py-2 rounded-full text-sm">🏠 Casa Inteligente</span>
      <span class="bg-white/20 px-4 py-2 rounded-full text-sm">💼 Negócios</span>
      <span class="bg-white/20 px-4 py-2 rounded-full text-sm">🎯 Estilo de Vida</span>
    </div>
  </div>
</section>

<!-- Main Content -->
<main class="max-w-7xl mx-auto p-4 py-8">
  
  <!-- Filtros e Pesquisa -->
  <section class="mb-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <!-- Filtros de Categoria -->
    <div class="flex flex-wrap gap-2">
      <button class="filter-btn bg-blue-500 ring-2 ring-blue-400 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold" data-filter="all">
        Todos
      </button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold" data-filter="guias">
        Guias
      </button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold" data-filter="noticias">
       Notícias
      </button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold" data-filter="dicas">
        Dicas
      </button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition font-semibold" data-filter="reviews">
        Reviews
      </button>
    </div>
    
    <!-- Barra de Pesquisa -->
    <div class="flex">
      <input type="text" 
             id="blog-search" 
             placeholder="Pesquisar no blog..." 
             class="border border-gray-300 rounded-l-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 w-64">
      <button id="blog-search-btn" 
              class="bg-blue-500 text-white px-4 py-2 rounded-r-lg hover:bg-blue-600 transition">
        🔍
      </button>
    </div>
  </section>

  <!-- Post em Destaque (primeiro post publicado mais recente) -->
  {% set featuredPost = publishedPosts[0] %}
  {% if featuredPost %}
  <section class="mb-12">
    <div class="bg-gradient-to-r from-purple-600 to-indigo-600 rounded-2xl overflow-hidden shadow-2xl">
      <div class="flex flex-col lg:flex-row">
        <!-- Imagem -->
        <div class="lg:w-1/2">
          <div class="w-full h-full min-h-[300px] lg:min-h-[100%] overflow-hidden">
            <img 
              src="{{ featuredPost.data.imagem or '/assets/img/blog-default.jpg' }}" 
              alt="{{ featuredPost.data.title }}"
              class="w-full h-full object-contain bg-black"
            >
          </div>
        </div>
        
        <!-- Conteúdo -->
        <div class="lg:w-1/2 p-8 text-white flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-yellow-400 text-gray-900 px-3 py-1 rounded-full text-xs font-bold">
              ⭐ EM DESTAQUE
            </span>
            <span class="category-badge bg-white/20 px-3 py-1 rounded-full">
              {{ featuredPost.data.categoriaBlog or 'Geral' }}
            </span>
          </div>
          
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            {{ featuredPost.data.title }}
          </h2>
          
          <p class="text-lg text-purple-100 mb-6 leading-relaxed">
            {{ featuredPost.data.description or (featuredPost.templateContent | excerpt(200)) }}
          </p>
          
          <div class="flex items-center gap-4 text-sm text-purple-200 mb-6">
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              {{ featuredPost.date | formatDate }}
            </span>
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {{ featuredPost.templateContent | readingTime }} de leitura
            </span>
          </div>
          
          <a href="{{ featuredPost.url }}" 
            onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_post_destaque', {'titulo': '{{ featuredPost.data.title }}', 'categoria': '{{ featuredPost.data.categoriaBlog }}'}); }"
            class="bg-white text-purple-600 px-8 py-3 rounded-lg hover:bg-purple-50 transition font-bold inline-flex items-center gap-2 w-fit shadow-lg hover:shadow-xl">
            Ler artigo completo
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Grid de Posts -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800">Todos os artigos</h2>
      <p class="text-gray-600">{{ publishedPosts.length }} artigo(s)</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for post in publishedPosts %}
      
      <div class="blog-card blog-post-card bg-white rounded-xl shadow-lg overflow-hidden flex flex-col" 
           data-categoria="{{ post.data.categoriaBlog or 'geral' }}">
        
        <!-- Imagem -->
        <div class="relative aspect-video bg-gradient-to-br from-blue-100 to-purple-100 overflow-hidden">
          <img 
            src="{{ post.data.imagem or '/assets/img/blog-default.jpg' }}" 
            alt="{{ post.data.title }}"
            class="absolute inset-0 w-full h-full object-cover object-center"
          >
          <!-- Badge de Categoria -->
          <div class="absolute top-3 left-3">
            {% set categoryColor = 'bg-blue-500' %}
            {% if post.data.categoriaBlog == 'guias' %}
              {% set categoryColor = 'bg-green-500' %}
            {% elif post.data.categoriaBlog == 'noticias' %}
              {% set categoryColor = 'bg-red-500' %}
            {% elif post.data.categoriaBlog == 'dicas' %}
              {% set categoryColor = 'bg-yellow-500' %}
            {% elif post.data.categoriaBlog == 'reviews' %}
              {% set categoryColor = 'bg-purple-500' %}
            {% endif %}
            
            <span class="category-badge {{ categoryColor }} text-white px-3 py-1 rounded-full shadow-md">
              {{ post.data.categoriaBlog or 'Geral' }}
            </span>
          </div>
        </div>
        
        <!-- Conteúdo -->
        <div class="p-6 flex flex-col flex-grow">
          <h3 class="text-xl font-bold text-gray-800 mb-3 line-clamp-2 hover:text-blue-600 transition">
            {{ post.data.title }}
          </h3>
          
          <p class="post-excerpt text-gray-600 text-sm mb-4 flex-grow line-clamp-3">
            {{ post.data.description or (post.templateContent | excerpt(150)) }}
          </p>
          
          <!-- Meta Info -->
          <div class="flex items-center justify-between text-xs text-gray-500 mb-4 pb-4 border-b border-gray-100">
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              {{ post.date | shortDate }}
            </span>
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {{ post.templateContent | readingTime }}
            </span>
          </div>
          
          <!-- Botão Ler Mais -->
          <a href="{{ post.url }}" 
            onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_post_grid', {'titulo': '{{ post.data.title }}', 'categoria': '{{ post.data.categoriaBlog }}'}); }"
            class="bg-blue-500 text-white px-5 py-2.5 rounded-lg text-center hover:bg-blue-600 transition font-semibold flex items-center justify-center gap-2">
            Ler mais
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
      
      {% endfor %}
      
      {% if publishedPosts.length == 0 %}
      <div class="col-span-full text-center py-16 bg-white rounded-xl shadow-md">
        <div class="text-6xl mb-4">📝</div>
        <p class="text-gray-500 text-lg mb-2">Nenhum artigo publicado ainda.</p>
        <p class="text-gray-400 text-sm">Em breve teremos conteúdo incrível para você!</p>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- Call to Action -->
  <section class="mt-16 bg-gradient-to-r from-green-400 to-blue-500 rounded-2xl p-8 text-center text-white shadow-xl">
    <h3 class="text-3xl font-bold mb-4">💌 Não perca nenhuma novidade!</h3>
    <p class="text-lg mb-6 text-green-50">Receba dicas exclusivas sobre produtos inteligentes direto no seu email</p>
    <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input type="email" 
             placeholder="Seu melhor email..." 
             class="flex-grow px-4 py-3 rounded-lg text-gray-800 focus:outline-none focus:ring-2 focus:ring-white">
      <button 
        onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_newsletter', {'origem': 'blog'}); }"
        class="bg-white text-green-600 px-6 py-3 rounded-lg hover:bg-green-50 transition font-bold shadow-lg">
        Inscrever-se
      </button>
    </div>
  </section>

</main>