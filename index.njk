---
layout: base.njk

---

<!-- Banner / slogan -->
<section class="text-center py-6 bg-gray-100">
  <h2 class="text-2xl font-bold">Produtos inteligentes para sua casa, seu negócio e sua vida!</h2>
</section>

<!-- Main -->
<main class="max-w-7xl mx-auto p-4">
  <!-- Menu de filtros + pesquisa -->
  <section class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Filtros -->
    <div class="flex flex-wrap gap-2">
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" data-filter="casa">Sua Casa</button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded cursor-not-allowed opacity-60" disabled data-filter="escritorio">Seu Negócio</button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded cursor-not-allowed opacity-60" disabled data-filter="vida">Sua Vida</button>
      <button class="filter-btn bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400" data-filter="all">Todos</button>
    </div>
    <!-- Barra de pesquisa -->
    <div class="flex">
      <input type="text" id="search-input" placeholder="Pesquisar produto..." class="border border-gray-300 rounded-l px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <button id="search-btn" class="bg-blue-500 text-white px-4 py-2 rounded-r hover:bg-blue-600">🔍</button>
    </div>
  </section>
  
  <!-- Carrosséis de produtos por subcategoria -->
  <section id="produtos">
    <h2 class="text-2xl font-bold mb-6">Ofertas em destaque</h2>
    <p class="text-gray-600 mb-4">{{ collections.produto.length }} produto(s) encontrado(s)</p>
    
    <div class="space-y-12">
      
      {# Agrupa produtos por subcategoria usando lógica do template #}
      {% set subcategorias = [] %}
      {% for produto in collections.produto %}
        {% set subcat = produto.data.subcategoria or 'outros' %}
        {% if subcat not in subcategorias %}
          {% set subcategorias = (subcategorias.push(subcat), subcategorias) %}
        {% endif %}
      {% endfor %}
      
      {% for subcategoria in subcategorias %}
      
      {# Filtra produtos desta subcategoria #}
      {% set produtosDaSubcat = [] %}
      {% for produto in collections.produto %}
        {% if (produto.data.subcategoria or 'outros') == subcategoria %}
          {% set produtosDaSubcat = (produtosDaSubcat.push(produto), produtosDaSubcat) %}
        {% endif %}
      {% endfor %}
      
      {% if produtosDaSubcat.length > 0 %}
      
      <!-- Seção da Subcategoria -->
      <div class="subcategoria-section border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm">
        <!-- Cabeçalho Colapsável -->
        <div class="flex items-center justify-between p-4 cursor-pointer hover:bg-gray-50 transition collapse-header"
             data-subcategoria="{{ subcategoria }}">
          <div class="flex items-center gap-3">
            <button class="collapse-toggle text-gray-500 hover:text-gray-700 transition transform">
              <svg class="w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <h3 class="text-xl font-bold text-gray-800 capitalize">
              {{ subcategoria | replace("-", " ") }}
            </h3>
            <span class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded-full">{{ produtosDaSubcat.length }}</span>
          </div>
          <a href="/produtos/casa/{{ subcategoria }}" 
             class="text-sm text-blue-600 hover:text-blue-800 font-semibold flex items-center gap-1 hover:gap-2 transition-all"
             onclick="event.stopPropagation();">
            Ver Todos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <!-- Conteúdo Colapsável -->
        <div class="collapse-content">
          <div class="p-4 pt-0">
        
        <!-- Carrossel -->
        <div class="produtos-carousel-container relative">
          <div class="produtos-carousel flex gap-4 overflow-x-auto scroll-smooth pb-4" 
               style="scrollbar-width: none; -ms-overflow-style: none;"
               data-subcategoria="{{ subcategoria }}">
            
            {% for produto in produtosDaSubcat %}
            {% set ofertas = produto.data.ofertas | sort(attribute='preco') %}
            {% set melhorOferta = ofertas[0] if ofertas else null %}
            
            <!-- Card do Produto no Carrossel -->
            <div class="produto-carousel-card flex-shrink-0 bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow"
                 style="width: 280px;"
                 data-categoria="{{ produto.data.categoria or 'geral' }}">
              
              <!-- Imagem -->
              <div class="relative w-full h-40 bg-white flex items-center justify-center p-3">
                <img src="{{ produto.data.imagemCard or produto.data.imagens[0].src or '/assets/img/placeholder.jpg' }}" 
                     alt="{{ produto.data.produtoNome }}" 
                     class="max-h-full max-w-full object-contain"
                     loading="lazy">
                
                {% if produto.data.novo %}
                <span class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 text-xs font-bold rounded">NOVO</span>
                {% endif %}
              </div>
              
              <!-- Conteúdo -->
              <div class="p-3 flex flex-col" style="min-height: 200px;">
                {% if produto.data.marca %}
                <div class="text-xs text-gray-500 uppercase font-semibold mb-1">{{ produto.data.marca }}</div>
                {% endif %}
                
                <h4 class="text-sm font-bold mb-2 line-clamp-2">{{ produto.data.produtoNome }}</h4>
                
                <p class="text-gray-600 text-xs mb-3 flex-grow line-clamp-2">
                  {{ produto.data.description or produto.data.produtoDescricao or "Descrição não disponível" }}
                </p>
                
                <!-- Preço + Botão Ver Ofertas -->
                {% if melhorOferta %}
                <div class="mb-2">
                  <div class="bg-green-50 rounded-lg px-2 py-1.5 mb-2">
                    <p class="text-xs text-gray-600">A partir de</p>
                    <p class="text-lg font-bold text-green-600">R$ {{ melhorOferta.preco | replace(".", ",") }}</p>
                  </div>
                  <button class="toggle-ofertas w-full bg-blue-500 text-white px-3 py-2 rounded-lg hover:bg-blue-600 transition text-sm font-semibold flex items-center justify-center gap-2"
                          onclick="if(typeof gtag !== 'undefined') { gtag('event', 'abrir_ofertas_home', {'produto': '{{ produto.data.produtoNome }}'}); }">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Ver Ofertas
                  </button>
                </div>
                {% endif %}
                
                <!-- Botão Ver Detalhes -->
                <a href="{{ produto.url }}" 
                  onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_ver_detalhes_home', {'produto': '{{ produto.data.produtoNome }}'}); }"
                  class="bg-gray-800 text-white px-3 py-2 rounded-lg text-center hover:bg-gray-900 transition text-sm font-semibold flex items-center justify-center gap-2">
                  Ver Detalhes
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
              
              <!-- OVERLAY DE OFERTAS -->
              {% if ofertas and ofertas.length > 0 %}
              <div class="ofertas-overlay">
                <div class="ofertas-overlay-content">
                  <!-- Botão Fechar -->
                  <button class="close-ofertas absolute top-3 right-3 bg-white/20 hover:bg-white/30 text-white p-2 rounded-full transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                  
                  <!-- Título -->
                  <div class="text-center mb-6">
                    <h3 class="text-white text-xl font-bold mb-1">💰 Melhores Ofertas</h3>
                    <p class="text-gray-300 text-sm">Clique para comprar</p>
                  </div>
                  
                  <!-- Lista de Ofertas -->
                  <div class="space-y-2">
                    {% for oferta in ofertas %}
                    {% set posicao = loop.index %}
                    {% set emoji = '🥇' if posicao == 1 else ('🥈' if posicao == 2 else ('🥉' if posicao == 3 else ('4️⃣' if posicao == 4 else '🪙'))) %}
                    {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
                    {% if oferta.marketplace == 'Mercado Livre' %}
                      {% set bgColor = 'bg-yellow-400 hover:bg-yellow-500 text-gray-800' %}
                    {% elif oferta.marketplace == 'Shopee' %}
                      {% set bgColor = 'bg-orange-500 hover:bg-orange-600' %}
                    {% elif oferta.marketplace == 'Amazon' %}
                      {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
                    {% else %}
                      {% set bgColor = 'bg-green-500 hover:bg-green-600' %}
                    {% endif %}
                    
                    <a href="{{ oferta.link }}" 
                      target="_blank" 
                      rel="noopener noreferrer nofollow"
                      onclick="if(typeof gtag !== 'undefined') { gtag('event', 'click_oferta_overlay_home', {'marketplace': '{{ oferta.marketplace }}', 'produto': '{{ produto.data.produtoNome }}', 'preco': '{{ oferta.preco }}', 'posicao': '{{ posicao }}'}); }"
                      class="{{ bgColor }} text-white text-xs px-3 py-3 rounded-lg font-semibold transition shadow-md hover:shadow-lg flex items-center justify-between gap-2">
                      <span class="flex items-center gap-2">
                        <span class="text-lg">{{ emoji }}</span>
                        <span class="flex flex-col items-start leading-tight">
                          <span>{{ oferta.marketplace }}</span>
                          {% if oferta.freteGratis %}
                            <span class="text-xs text-white font-normal">Frete grátis</span>
                          {% else %}
                            <span class="text-xs text-white font-normal">Consulte o frete</span>
                          {% endif %}
                        </span>
                      </span>
                      <span class="text-lg font-bold">R$ {{ oferta.preco | replace(".", ",") }}</span>
                    </a>
                    {% endfor %}
                  </div>
                </div>
              </div>
              {% endif %}
              
            </div>
            {% endfor %}
            
          </div>
          
          <!-- Botões de Navegação -->
          {% if produtosDaSubcat.length > 1 %}
          <button class="carousel-nav-prev absolute left-0 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110 z-10 hidden md:block"
                  aria-label="Ver produtos anteriores">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
          <button class="carousel-nav-next absolute right-0 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white p-3 rounded-full shadow-lg transition hover:scale-110 z-10 hidden md:block"
                  aria-label="Ver próximos produtos">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
          {% endif %}
          
        </div>
      </div>
      
      {% endif %}
      {% endfor %}
      
      {% if collections.produto.length == 0 %}
      <div class="text-center py-12 bg-white rounded-lg shadow-md">
        <p class="text-gray-500 text-lg mb-2">😕 Nenhum produto cadastrado ainda.</p>
        <p class="text-gray-400 text-sm">Adicione produtos com <code class="bg-gray-100 px-2 py-1 rounded">tags: ["produto"]</code></p>
      </div>
      {% endif %}

    </div>
  </section>
</main>