---
layout: base.njk
title: Smart Life Brasil - Produtos Inteligentes
description: Produtos inteligentes para sua casa, seu negócio e sua vida! Encontre as melhores ofertas de dispositivos smart.
customCSS: |
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap');
  body { font-family: 'Poppins', sans-serif; }
  
  /* Line clamp */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Cards com hover suave */
  .product-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: visible; 
  }
  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }
  
  /* Ofertas expandíveis - overlay absoluto */
  .ofertas-expandiveis {
    animation: slideDown 0.25s ease-out;
  }
  
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Dropdown toggle - rotação da seta */
  .dropdown-arrow {
    transition: transform 0.3s ease;
  }
  .dropdown-arrow.open {
    transform: rotate(180deg);
  }

customScript: |
  // === TOGGLE DROPDOWN OFERTAS ===
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-dropdown').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.product-card');
        const dropdown = card.querySelector('.ofertas-expandiveis');
        const arrow = btn.querySelector('.dropdown-arrow');
        
        if (dropdown.classList.contains('hidden')) {
          dropdown.classList.remove('hidden');
          arrow.classList.add('open');
        } else {
          dropdown.classList.add('hidden');
          arrow.classList.remove('open');
        }
      });
    });
  });

  // === FILTROS ===
  const filterBtns = document.querySelectorAll('.filter-btn');
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filter;
      const produtosCards = document.querySelectorAll('.grid-produtos > div');
      
      produtosCards.forEach(p => {
        if (filtro === 'all' || p.dataset.categoria === filtro) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });
      
      // Destaca o botão ativo
      filterBtns.forEach(b => {
        b.classList.remove('ring-2', 'ring-blue-300', 'bg-blue-600');
        b.classList.add('bg-blue-500');
      });
      btn.classList.add('ring-2', 'ring-blue-300', 'bg-blue-600');
      btn.classList.remove('bg-blue-500');
    });
  });

  // === PESQUISA ===
  const searchInput = document.getElementById('search-input');
  const searchBtn = document.getElementById('search-btn');

  function pesquisar() {
    const termo = searchInput.value.toLowerCase();
    const produtosCards = document.querySelectorAll('.grid-produtos > div');
    
    produtosCards.forEach(p => {
      const nome = p.querySelector('h3').textContent.toLowerCase();
      if (nome.includes(termo)) {
        p.classList.remove('hidden');
      } else {
        p.classList.add('hidden');
      }
    });
  }

  searchBtn.addEventListener('click', pesquisar);
  searchInput.addEventListener('keyup', e => {
    if (e.key === 'Enter') pesquisar();
  });
---

<!-- Banner / slogan -->
<section class="text-center py-6 bg-gray-100">
  <h2 class="text-2xl font-bold">Produtos inteligentes para sua casa, seu negócio e sua vida!</h2>
</section>

<!-- Main -->
<main class="max-w-7xl mx-auto p-4">
  <!-- Menu de filtros + pesquisa -->
  <section class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Filtros -->
    <div class="flex flex-wrap gap-2">
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" data-filter="casa">Sua Casa</button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" data-filter="escritorio">Seu Negócio</button>
      <button class="filter-btn bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" data-filter="vida">Sua Vida</button>
      <button class="filter-btn bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400" data-filter="all">Todos</button>
    </div>
    <!-- Barra de pesquisa -->
    <div class="flex">
      <input type="text" id="search-input" placeholder="Pesquisar produto..." class="border border-gray-300 rounded-l px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <button id="search-btn" class="bg-blue-500 text-white px-4 py-2 rounded-r hover:bg-blue-600">🔍</button>
    </div>
  </section>
  
  <!-- Grid de produtos -->
  <section id="produtos">
    <h2 class="text-2xl font-bold mb-6">Ofertas em destaque</h2>
    <p class="text-gray-600 mb-4">{{ collections.produto.length }} produto(s) encontrado(s)</p>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 grid-produtos">
      
      {% for produto in collections.produto %}
      {% set ofertas = produto.data.ofertas | sort(attribute='posicao') %}
      {% set melhorOferta = ofertas[0] if ofertas else null %}
      
      <div class="product-card bg-white rounded-lg shadow-md flex flex-col" 
           data-categoria="{{ produto.data.categoria or 'geral' }}">
        
        <!-- Imagem Container (MENOR) -->
        <div class="relative w-full h-48 bg-white flex items-center justify-center p-4">
          <img src="{{ produto.data.imagemCard or produto.data.imagens[0].src or '/assets/img/placeholder.jpg' }}" 
               alt="{{ produto.data.produtoNome }}" 
               class="max-h-full max-w-full object-contain">
          
          {% if produto.data.novo %}
          <span class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 text-xs font-bold rounded">NOVO</span>
          {% endif %}
        </div>
        
        <!-- Conteúdo -->
        <div class="p-4 flex flex-col flex-grow">
          {% if produto.data.marca %}
          <div class="text-xs text-gray-500 uppercase font-semibold mb-1">{{ produto.data.marca }}</div>
          {% endif %}
          
          <h3 class="text-lg font-bold mb-2 line-clamp-2">{{ produto.data.produtoNome }}</h3>
          
          <p class="text-gray-600 text-sm mb-3 flex-grow line-clamp-2">
            {{ produto.data.description or produto.data.produtoDescricao or "Descrição não disponível" }}
          </p>
          
          <!-- DROPDOWN INLINE NO PREÇO -->
          {% if melhorOferta %}
          <div class="mb-3 relative">
            <button class="toggle-dropdown flex items-center justify-between w-full bg-green-50 hover:bg-green-100 transition rounded-lg px-3 py-2 group">
              <div class="flex items-center gap-2">
                <span class="text-xs text-gray-600">A partir de</span>
                <span class="text-xl font-bold text-green-600">R$ {{ melhorOferta.preco | replace(".", ",") }}</span>
              </div>
              <svg class="dropdown-arrow w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- OFERTAS EXPANDÍVEIS (Overlay Absoluto) -->
            {% if ofertas and ofertas.length > 0 %}
            <div class="ofertas-expandiveis hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg p-2 space-y-1.5 z-10">
              {% for oferta in ofertas %}
              {% set emoji = '🥇' if oferta.posicao == 1 else ('🥈' if oferta.posicao == 2 else ('🥉' if oferta.posicao == 3 else ('4️⃣' if oferta.posicao == 4 else '🏪'))) %}
              {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
              {% if oferta.marketplace == 'Mercado Livre' %}
                {% set bgColor = 'bg-yellow-400 hover:bg-yellow-500 text-gray-800' %}
              {% elif oferta.marketplace == 'Shopee' %}
                {% set bgColor = 'bg-orange-500 hover:bg-orange-600' %}
              {% elif oferta.marketplace == 'Amazon' %}
                {% set bgColor = 'bg-blue-600 hover:bg-blue-700' %}
              {% else %}
                {% set bgColor = 'bg-green-500 hover:bg-green-600' %}
              {% endif %}
              
              <a href="{{ oferta.link }}" 
                 target="_blank" 
                 rel="noopener noreferrer nofollow"
                 class="{{ bgColor }} text-white px-3 py-1.5 rounded-lg text-sm font-semibold transition shadow-sm hover:shadow-md flex items-center justify-between gap-2">
                <span class="flex items-center gap-1.5">
                  <span class="text-xs">{{ emoji }}</span>
                  <span>{{ oferta.marketplace }}</span>
                </span>
                <span class="font-bold">R$ {{ oferta.preco | replace(".", ",") }}</span>
              </a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endif %}
          
          <!-- Botão Ver Detalhes -->
          <a href="{{ produto.url }}" 
             class="bg-gray-800 text-white px-4 py-2.5 rounded-lg text-center hover:bg-gray-900 transition font-semibold flex items-center justify-center gap-2">
            Ver Detalhes
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
      {% endfor %}
      
      {% if collections.produto.length == 0 %}
      <div class="col-span-full text-center py-12 bg-white rounded-lg shadow-md">
        <p class="text-gray-500 text-lg mb-2">😕 Nenhum produto cadastrado ainda.</p>
        <p class="text-gray-400 text-sm">Adicione produtos com <code class="bg-gray-100 px-2 py-1 rounded">tags: ["produto"]</code></p>
      </div>
      {% endif %}

    </div>
  </section>
</main>